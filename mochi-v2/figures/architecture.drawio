<mxfile host="app.diagrams.net"><diagram name="Server architecture" id="mochi-arch"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Host A: server process (py main.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;fontSize=13;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=20;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1080" height="695" as="geometry"/></mxCell><mxCell id="clients" value="Clients (Hosts B and C): browser&lt;br&gt;loads index.html, style.css, app.js, then speaks WebSocket" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="600" height="70" as="geometry"/></mxCell><mxCell id="config" value="config.py&lt;br&gt;settings and limits&lt;br&gt;(used by all modules)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="165" width="190" height="70" as="geometry"/></mxCell><mxCell id="main" value="main.py&lt;br&gt;accept loop on 0.0.0.0:5000, one thread per connection" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="165" width="600" height="70" as="geometry"/></mxCell><mxCell id="conn" value="connection.py&lt;br&gt;reads the first HTTP request, then serves a file&lt;br&gt;or runs the WebSocket loop until the socket closes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#ffffff;s